# Copy to .env and fill in your key.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# Vision-capable model; aligned with the working camera-project config.
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
LLM_PROVIDER=OpenAI
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=180
LLM_SSL_VERIFY=true
